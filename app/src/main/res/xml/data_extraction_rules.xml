<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ (API 31+) backup and device-transfer policy.

   Left rule-free on purpose, for the same reasons as backup_rules.xml: the
   "Back up user certificate" setting is a runtime switch, so no static rule can
   express it, and any <include> would restrict the whole backup set (dropping
   the Room database and the DataStore settings).

   The client certificate private key is kept out of BOTH cloud backup and
   device transfer by where it lives: noBackupFilesDir while the setting is off
   (the default), filesDir once the user opts in by moving it. See
   CertificateVault and UserCertificateStore.

   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- No <include>/<exclude>: back up everything the platform does not
             already exclude on its own. -->
    </cloud-backup>
    <!-- No <device-transfer> section: with no rules, everything not already
         excluded (such as noBackupFilesDir) is transferred to the new device. -->
</data-extraction-rules>
